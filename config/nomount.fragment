# NoMount — caymanslm (4.9.337, non-GKI)
#
# Mountless systemless-mod engine (github.com/maxsteeel/nomount, v2.0.0). Injects
# files and redirects paths purely at the VFS layer so /proc/mounts stays stock;
# it replaces the module MOUNT mechanism, not KernelSU (root still comes from KSU).
# The self-contained fs/nomount/ subdir (Kconfig, Makefile, nomount.c, nomount.h)
# lands via patches/kernel/caymanslm-zz-nomount-4.9-integration.patch, applied
# LAST by setup-tree.sh (it shares fs/Kconfig + fs/Makefile with SuSFS). v2.0.0
# intercepts by hijacking i_op/i_fop/s_op vectors when the userspace `nm` binary
# adds a rule, so -- unlike v1.1.0 -- it patches NO core VFS files.
#
# Control channel is a keyring key_type "nomount" driven by add_key(2); ABI is
# NOMOUNT_VERSION "20". The userspace metamodule MUST be v2.0.0 to match -- a
# v1.1.x Netlink `nm` cannot talk to this kernel. See [[nomount-version-must-match-module]].
#
# Inert until `nm` adds rules: with no hijacked dirs, every fake op-vector falls
# through to the original. No CONFIG_KPROBES needed.
CONFIG_NOMOUNT=y
