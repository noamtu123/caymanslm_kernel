# Full diagnostic profile. Applied only with:
#   ./scripts/build.sh --profile=debug
#
# It is deliberately noisy and disclosure-friendly for device bring-up.  Do
# not ship it.  The release target remains config/profiles/release.fragment.

CONFIG_PRINTK=y
CONFIG_AUDIT=y
CONFIG_KALLSYMS=y
CONFIG_KALLSYMS_ALL=y
CONFIG_KALLSYMS_BASE_RELATIVE=y
CONFIG_DEBUG_INFO=y
CONFIG_DEBUG_FS=y
CONFIG_FTRACE=y
CONFIG_PSTORE=y
CONFIG_PSTORE_RAM=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_PMSG=y
CONFIG_SECURITY_DMESG_RESTRICT=y

# Match the booting diagnostic control: leave dynamic debug and function tracing
# off (Kprobes stays disabled for the tested manual-hook path).  SuSFS logging is
# now enabled in the base ksu.fragment for every profile, so this file no longer
# overrides it off.
# CONFIG_DYNAMIC_DEBUG is not set
# CONFIG_FUNCTION_TRACER is not set
# CONFIG_FUNCTION_GRAPH_TRACER is not set

# Flip the shipped kernel's fail-closed CONFIG_PANIC_ON_OOPS=y (config/diag.fragment)
# back OFF for active hook development: keep the kernel alive after a fault so the
# full backtrace can be read live with `dmesg` before the watchdog resets. On this
# device that live read is the ONLY capture that works -- the LG bootloader wipes
# pstore on reboot, so a panic would leave nothing. This profile is never shipped.
# CONFIG_PANIC_ON_OOPS is not set
