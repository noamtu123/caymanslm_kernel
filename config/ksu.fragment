# KernelSU Next — caymanslm (4.9.337, non-GKI)
#
# Manual hooks, not kprobes. This kernel is pre-4.14 and has no CONFIG_KPROBES;
# KSU_KPROBES_HOOK additionally requires >= 5.10, so it is not an option here.
# The hook call sites live in patches/kernel/caymanslm-ksu-manual-hooks.patch.
CONFIG_KSU=y
CONFIG_KSU_MANUAL_HOOK=y
CONFIG_KSU_SUSFS=y
CONFIG_KSU_SUSFS_SUS_PATH=y
CONFIG_KSU_SUSFS_SUS_MOUNT=y
CONFIG_KSU_SUSFS_SUS_KSTAT=y
CONFIG_KSU_SUSFS_SPOOF_UNAME=y
# SuSFS log output goes to the kernel ring buffer (printk), which this build
# gates behind dmesg_restrict=1 + kptr_restrict=2, and the module's susfs.log
# lives under /data/adb (0700 root). Neither surface is reachable by an
# unprivileged app -- the threat we actually hide from -- so disabling this buys
# no stealth against apps while costing all boot-time visibility into what SuSFS
# is doing (and leaving the susfs4ksu WebUI with an empty log). Keep it on.
CONFIG_KSU_SUSFS_ENABLE_LOG=y
CONFIG_KSU_SUSFS_HIDE_KSU_SUSFS_SYMBOLS=y
CONFIG_KSU_SUSFS_SPOOF_CMDLINE_OR_BOOTCONFIG=y
CONFIG_KSU_SUSFS_OPEN_REDIRECT=y
CONFIG_KSU_SUSFS_SUS_MAP=y
# Android's VINTF checker requires /proc/config.gz on this device.  The kernel
# patch caymanslm-sanitized-ikconfig.patch keeps this endpoint available while
# embedding a public config view with CONFIG_KSU* entries removed.
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y
CONFIG_SECURITY_DMESG_RESTRICT=y

# CONFIG_KPROBES is deliberately left unset. Beyond being unnecessary, the
# upstream guidance is to keep it off with manual hooks so a volume-down press
# after boot cannot accidentally trip safe mode via a second input hook.
