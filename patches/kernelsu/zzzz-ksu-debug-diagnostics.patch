diff --git a/kernel/infra/diagnostics.c b/kernel/infra/diagnostics.c
new file mode 100644
--- /dev/null
+++ b/kernel/infra/diagnostics.c
@@ -0,0 +1,93 @@
+#include <linux/init.h>
+#include <linux/jiffies.h>
+#include <linux/kernel.h>
+#include <linux/proc_fs.h>
+#include <linux/sched.h>
+#include <linux/seq_file.h>
+#include <linux/spinlock.h>
+#include <stdarg.h>
+#include <linux/uidgid.h>
+
+#include "diagnostics.h"
+
+#define KSU_DIAG_EVENTS 96
+#define KSU_DIAG_TEXT 96
+
+struct ksu_diag_entry {
+	unsigned long when;
+	pid_t pid;
+	uid_t uid;
+	char text[KSU_DIAG_TEXT];
+};
+
+static struct ksu_diag_entry entries[KSU_DIAG_EVENTS];
+static DEFINE_SPINLOCK(entries_lock);
+static unsigned int entries_head;
+static unsigned int entries_count;
+
+void ksu_diag_event(const char *fmt, ...)
+{
+	struct ksu_diag_entry *entry;
+	unsigned long flags;
+	va_list args;
+
+	spin_lock_irqsave(&entries_lock, flags);
+	entry = &entries[entries_head];
+	entry->when = jiffies;
+	entry->pid = current->pid;
+	entry->uid = current_uid().val;
+	va_start(args, fmt);
+	vscnprintf(entry->text, sizeof(entry->text), fmt, args);
+	va_end(args);
+	entries_head = (entries_head + 1) % KSU_DIAG_EVENTS;
+	if (entries_count < KSU_DIAG_EVENTS)
+		entries_count++;
+	spin_unlock_irqrestore(&entries_lock, flags);
+}
+
+static int ksu_diag_show(struct seq_file *m, void *unused)
+{
+	unsigned long flags;
+	unsigned int i, start, count;
+
+	spin_lock_irqsave(&entries_lock, flags);
+	start = (entries_head + KSU_DIAG_EVENTS - entries_count) % KSU_DIAG_EVENTS;
+	count = entries_count;
+	spin_unlock_irqrestore(&entries_lock, flags);
+	seq_puts(m, "KernelSU diagnostic ring (debug build)\n");
+	for (i = 0; i < count; i++) {
+		struct ksu_diag_entry entry;
+
+		spin_lock_irqsave(&entries_lock, flags);
+		entry = entries[(start + i) % KSU_DIAG_EVENTS];
+		spin_unlock_irqrestore(&entries_lock, flags);
+		seq_printf(m, "[%lu] pid=%d uid=%u %s\n", entry.when,
+			   entry.pid, entry.uid, entry.text);
+	}
+	return 0;
+}
+
+static int ksu_diag_open(struct inode *inode, struct file *file)
+{
+	return single_open(file, ksu_diag_show, NULL);
+}
+
+static const struct file_operations ksu_diag_fops = {
+	.owner = THIS_MODULE,
+	.open = ksu_diag_open,
+	.read = seq_read,
+	.llseek = seq_lseek,
+	.release = single_release,
+};
+
+void __init ksu_diag_init(void)
+{
+	if (!proc_create("ksu_diag", 0444, NULL, &ksu_diag_fops))
+		pr_err("ksu_diag: proc creation failed\n");
+	else
+		ksu_diag_event("ring initialized");
+}
