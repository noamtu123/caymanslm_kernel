ksu: drop sucompat su-access kernel-log fingerprints (release stealth)

sucompat.c prints a line to the kernel ring on every su faccessat/stat/
execve/execveat. dmesg is root-restricted here, but these strings also sit
in .rodata and are pure fingerprints of a KSU su path. Remove all four.

diff --git a/kernel/feature/sucompat.c b/kernel/feature/sucompat.c
index d615b26..0d9cfc3 100644
--- a/kernel/feature/sucompat.c
+++ b/kernel/feature/sucompat.c
@@ -106,7 +106,6 @@ int ksu_handle_faccessat(int *dfd, const char __user **filename_user,
 
 	if (unlikely(!memcmp(path, su, sizeof(su)))) {
 		ksu_compat_sulog('a');
-		pr_info("faccessat su->sh!\n");
 		*filename_user = sh_user_path();
 	}
 
@@ -136,7 +135,6 @@ int ksu_handle_stat(int *dfd, const char __user **filename_user, int *flags)
 
 	if (unlikely(!memcmp(path, su, sizeof(su)))) {
 		ksu_compat_sulog('s');
-		pr_info("newfstatat su->sh!\n");
 		*filename_user = sh_user_path();
 	}
 
@@ -182,7 +180,6 @@ long ksu_handle_execve_sucompat(const char __user **filename_user, int orig_nr,
 
 	ksu_compat_sulog('x');
 
-    pr_info("sys_execve su found\n");
 	pending_sucompat = ksu_sulog_capture_sucompat(*filename_user, argv_user, GFP_KERNEL);
     *filename_user = ksud_user_path();
 
@@ -234,7 +231,6 @@ int ksu_handle_execveat_sucompat(int *fd, struct filename **filename_ptr,
 	if (likely(memcmp(filename->name, su, sizeof(su))))
 		return 0;
 
-	pr_info("do_execveat_common su found\n");
 	memcpy((void *)filename->name, ksud_path, sizeof(ksud_path));
 
 	escape_with_root_profile();
