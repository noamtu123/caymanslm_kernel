Subject: [PATCH] kernelsu: add newfstatat init.rc helper

The kernel syscall hook calls into KernelSU after the stat result has been
copied to userspace. Keep this helper in the KernelSU patch set because the
KernelSU source is added after the base kernel patches are replayed.

---
diff --git a/kernel/runtime/ksud_integration.c b/kernel/runtime/ksud_integration.c
--- a/kernel/runtime/ksud_integration.c
+++ b/kernel/runtime/ksud_integration.c
@@ -850,3 +850,28 @@ void ksu_handle_newfstat_ret(unsigned int *fd, struct stat __user **statbuf_ptr)
 	ksu_common_newfstat_ret(*fd, (void **)statbuf_ptr, STAT_NATIVE, "sys_newfstat");
 }
 
+void ksu_handle_newfstatat_ret(const char __user **filename_user,
+			struct stat __user **statbuf_ptr)
+{
+	const char init_rc[] = "/init.rc";
+	char path[sizeof(init_rc)] = { 0 };
+	void __user *st_size_ptr;
+	long size, new_size;
+
+	if (likely(!ksu_vfs_read_hook) || !is_init(current_cred()) ||
+		!filename_user || !*filename_user || !statbuf_ptr || !*statbuf_ptr)
+		return;
+
+	if (strncpy_from_user_nofault(path, *filename_user, sizeof(path)) !=
+			sizeof(init_rc) - 1 || memcmp(path, init_rc, sizeof(init_rc)))
+		return;
+
+	st_size_ptr = (void __user *)*statbuf_ptr + offsetof(struct stat, st_size);
+	if (copy_from_user(&size, st_size_ptr, sizeof(size)))
+		return;
+
+	new_size = size + ksu_rc_len;
+	if (!copy_to_user(st_size_ptr, &new_size, sizeof(new_size)))
+		pr_debug("sys_newfstatat: added ksu_rc_len to init.rc stat\n");
+}
+
