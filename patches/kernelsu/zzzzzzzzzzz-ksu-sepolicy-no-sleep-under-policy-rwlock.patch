-static inline const cpumask_t *ksu_get_current_cpumask_t() { return current->cpus_ptr; }
-#else
-static inline cpumask_t *ksu_get_current_cpumask_t() { return &current->cpus_allowed; }
-#endif
-
 #endif // #ifndef SELINUX_POLICY_INSTEAD_SELINUX_SS
 
 static int apply_kernelsu_rules_fn(void *ptr)
@@ -221,52 +218,48 @@ out_unlock:
 	mutex_unlock(&selinux_state.policy_mutex);
 #else
 
-	cpumask_t old_mask;
 	db = get_policydb();
 	rwlock_t *lock = ksu_get_policy_rwlock();
-	
+
 	if (!lock)
 		goto do_stop_machine;
 
 	/*
-	 * HACK: write_lock() is held with preempt enabled. DO NOT let the
-	 * task be migrated to any other CPU than the current CPU. And since
-	 * set_cpus_allowed_ptr() can sleep, use raw_smp_processor_id() to get
-	 * current CPU and bypass preemption checks.
+	 * policy_rwlock is a SPINNING reader/writer lock.  While it is held for
+	 * write, every reader spins with preemption disabled -- and the readers
+	 * include security_compute_av(), i.e. every SELinux permission check on
+	 * the system.  Nothing in this critical section may sleep.
+	 *
+	 * The previous form held the lock with preempt_enable() and pinned the
+	 * task to one CPU so the rule path's GFP_KERNEL allocations could sleep.
+	 * On this device that is a permanent deadlock, not a stall: once the
+	 * writer goes off-CPU (direct reclaim, or simply preemption) and any
+	 * reader lands on the single CPU it pinned itself to, the writer can
+	 * never be scheduled again and every reader spins forever.
+	 *
+	 * Observed before this change: PID 1 parked in ptrace_stop while
+	 * ReZygisk's ptrace monitor sat in state R burning 80% system time,
+	 * unrecoverable without a hard reset, on roughly one boot in five.
+	 *
+	 * ksu_policydb_gfp switches the rule path to GFP_ATOMIC for the duration,
+	 * so the section is genuinely atomic and the lock keeps normal semantics.
 	 */
