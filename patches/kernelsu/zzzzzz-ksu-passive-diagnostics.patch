diff --git a/kernel/Kconfig b/kernel/Kconfig
--- a/kernel/Kconfig
+++ b/kernel/Kconfig
@@ -16,3 +16,12 @@ config KSU_DEBUG
 	  Enable KernelSU debug mode.
 
+config KSU_DIAGNOSTICS
+	bool "KernelSU passive diagnostic ring (development only)"
+	depends on KSU
+	default n
+	help
+	  Publish a bounded KSU/SuSFS event timeline through /proc/ksu_diag.
+	  Unlike KSU_DEBUG this does not alter root policy. Do not enable it in
+	  a release or hiding-focused build because it discloses root-stack state.
+
 config KSU_DISABLE_MANAGER
 	bool "Disable KernelSU manager integration"
diff --git a/kernel/Kbuild b/kernel/Kbuild
--- a/kernel/Kbuild
+++ b/kernel/Kbuild
@@ -17,3 +17,3 @@ kernelsu-objs += extras.o
 kernelsu-objs += infra/file_wrapper.o
-kernelsu-$(CONFIG_KSU_DEBUG) += infra/diagnostics.o
+kernelsu-$(CONFIG_KSU_DIAGNOSTICS) += infra/diagnostics.o
 kernelsu-objs += infra/event_queue.o
diff --git a/kernel/core/init.c b/kernel/core/init.c
--- a/kernel/core/init.c
+++ b/kernel/core/init.c
@@ -23,5 +23,5 @@
 #include "ksu.h"
 #include "feature/sulog.h"
-#ifdef CONFIG_KSU_DEBUG
+#ifdef CONFIG_KSU_DIAGNOSTICS
 #include "infra/diagnostics.h"
 #endif
@@ -103,7 +103,7 @@ int __init kernelsu_init(void)
         pr_err("prepare cred failed!\n");
     }
-#ifdef CONFIG_KSU_DEBUG
+#ifdef CONFIG_KSU_DIAGNOSTICS
     ksu_diag_init();
     ksu_diag_event("kernelsu init late_loaded=%d", ksu_late_loaded);
 #endif
