+#ifdef CONFIG_KSU
+	/*
+	 * KernelSU: init execs /data/adb/ksud into the ksu domain, but /data is
+	 * mounted nosuid, so this path demands a bounded transition. The ksu
+	 * type is created at runtime and its type_datum is kzalloc'd, so
+	 * ->bounds is always 0 and security_bounded_transition() can never
+	 * succeed -- every ksud exec from init would fail with -EACCES and no
+	 * module would ever be mounted. KernelSU ships is_ksu_transition() for
+	 * exactly this case (guarded to <= 4.19); it permits only init -> ksu.
+	 */
+	if (is_ksu_transition(old_tsec, new_tsec))
+		return 0;
+#endif
