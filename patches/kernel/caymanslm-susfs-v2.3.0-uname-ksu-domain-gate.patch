@@ -768,6 +768,16 @@ void susfs_spoof_uname(struct new_utsname* tmp) {
 
 	if (!static_branch_unlikely(&susfs_is_uname_spoof_buffer_set))
 		return;
+	/* Wraith: the spoofed uname identifies THIS kernel only to root -- a `su`
+	 * session (uid 0) or ksu-domain tooling (the susfs manager WebUI) -- while
+	 * every unprivileged caller keeps reading the real, stock-looking utsname.
+	 * This inverts the usual susfs uname direction and is safe because our real
+	 * uname is already stock and the brand must never reach an app (uid >=
+	 * 10000). Gate on root uid OR the ksu domain: a normal `su` shell runs in
+	 * u:r:shell:s0, not u:r:ksu:s0, so the ksu-domain check alone misses it.
+	 */
+	if (current_uid().val != 0 && !susfs_is_current_ksu_domain())
+		return;
 	do {
 		seq = read_seqbegin(&susfs_uname_seqlock);
 		strscpy(tmp->release, my_uname.release, __NEW_UTS_LEN);
