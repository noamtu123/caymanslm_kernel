+
+static bool susfs_compat_dirent_hidden(struct super_block *sb, u64 ino)
+{
+	struct inode *inode;
+	bool hidden;
+
+	inode = ilookup(sb, ino);
+	if (!inode)
+		return false;
+	hidden = susfs_is_inode_sus_path(inode);
+	iput(inode);
+	return hidden;
+}
+
+static bool susfs_compat_init_dir(struct file *file, struct super_block **sb,
+				  struct path *data_path)
+{
+	*sb = file_inode(file)->i_sb;
+	if ((*sb)->s_magic == FUSE_SUPER_MAGIC &&
+	    !susfs_get_data_path(data_path)) {
+		*sb = data_path->dentry->d_inode->i_sb;
+		return true;
+	}
+	return false;
+}
+#endif
