diff --git a/security/selinux/ss/avtab.c b/security/selinux/ss/avtab.c
index 31345376aa9b..3382831ece99 100644
--- a/security/selinux/ss/avtab.c
+++ b/security/selinux/ss/avtab.c
@@ -65,6 +65,22 @@ static inline int avtab_hash(struct avtab_key *keyp, u32 mask)
 	return hash & mask;
 }
 
+/*
+ * Allocation mode for in-place policydb edits.
+ *
+ * KernelSU injects its rules while holding policy_rwlock for WRITE.  That is a
+ * spinning lock: every reader -- security_compute_av() among 27 sites in
+ * services.c, i.e. every SELinux permission check on the system -- spins with
+ * preemption disabled until the writer releases it.  A GFP_KERNEL allocation
+ * inside that section can enter direct reclaim and sleep, which leaves the lock
+ * held by a task that is not running while every other CPU spins.
+ *
+ * Default GFP_KERNEL preserves normal policy-load behaviour; KernelSU flips
+ * this to GFP_ATOMIC only for the duration of its own rule injection.
+ */
+gfp_t ksu_policydb_gfp = GFP_KERNEL;
+EXPORT_SYMBOL(ksu_policydb_gfp);
+
 static struct avtab_node*
 avtab_insert_node(struct avtab *h, int hvalue,
 		  struct avtab_node *prev, struct avtab_node *cur,
@@ -72,13 +88,13 @@ avtab_insert_node(struct avtab *h, int hvalue,
 {
 	struct avtab_node *newnode;
 	struct avtab_extended_perms *xperms;
-	newnode = kmem_cache_zalloc(avtab_node_cachep, GFP_KERNEL);
+	newnode = kmem_cache_zalloc(avtab_node_cachep, ksu_policydb_gfp);
 	if (newnode == NULL)
 		return NULL;
 	newnode->key = *key;
 
 	if (key->specified & AVTAB_XPERMS) {
-		xperms = kmem_cache_zalloc(avtab_xperms_cachep, GFP_KERNEL);
+		xperms = kmem_cache_zalloc(avtab_xperms_cachep, ksu_policydb_gfp);
 		if (xperms == NULL) {
 			kmem_cache_free(avtab_node_cachep, newnode);
 			return NULL;
@@ -95,7 +111,7 @@ avtab_insert_node(struct avtab *h, int hvalue,
 	} else {
 		newnode->next = flex_array_get_ptr(h->htable, hvalue);
 		if (flex_array_put_ptr(h->htable, hvalue, newnode,
-				       GFP_KERNEL|__GFP_ZERO)) {
+				       ksu_policydb_gfp|__GFP_ZERO)) {
 			kmem_cache_free(avtab_node_cachep, newnode);
 			return NULL;
 		}
@@ -330,7 +346,7 @@ int avtab_alloc(struct avtab *h, u32 nrules)
 	mask = nslot - 1;
 
 	h->htable = flex_array_alloc(sizeof(struct avtab_node *), nslot,
-				     GFP_KERNEL | __GFP_ZERO);
+				     ksu_policydb_gfp | __GFP_ZERO);
 	if (!h->htable)
 		return -ENOMEM;
 
diff --git a/security/selinux/ss/hashtab.c b/security/selinux/ss/hashtab.c
index 2cc496149842..ae4a16f9e934 100644
--- a/security/selinux/ss/hashtab.c
+++ b/security/selinux/ss/hashtab.c
@@ -57,7 +57,8 @@ int hashtab_insert(struct hashtab *h, void *key, void *datum)
 	if (cur && (h->keycmp(h, key, cur->key) == 0))
 		return -EEXIST;
 
-	newnode = kzalloc(sizeof(*newnode), GFP_KERNEL);
+	extern gfp_t ksu_policydb_gfp;
+	newnode = kzalloc(sizeof(*newnode), ksu_policydb_gfp);
 	if (newnode == NULL)
 		return -ENOMEM;
 	newnode->key = key;
