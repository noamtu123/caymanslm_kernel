 #include "avc_ss.h"
 
+#ifdef CONFIG_KSU_SUSFS
+extern bool selinux_sid_is_hidden_from_caller(u32 sid);
+#endif
+
 /* SECMARK reference count */
 static atomic_t selinux_secmark_refcount = ATOMIC_INIT(0);
 
@@ -5993,6 +5997,11 @@ static int selinux_setprocattr(struct task_struct *p,
 			return error;
 	}
 
+#ifdef CONFIG_KSU_SUSFS
+	if (selinux_sid_is_hidden_from_caller(sid))
+		return -EINVAL;
+#endif
+
 	new = prepare_creds();
 	if (!new)
 		return -ENOMEM;
