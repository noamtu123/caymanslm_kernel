 	length = scnprintf(buf, SIMPLE_TRANSACTION_LIMIT,
diff --git a/security/selinux/ss/services.c b/security/selinux/ss/services.c
index 3c97eb7a8c30..42ab72b61e0d 100644
--- a/security/selinux/ss/services.c
+++ b/security/selinux/ss/services.c
@@ -47,6 +47,10 @@
 #include <linux/errno.h>
 #include <linux/in.h>
 #include <linux/sched.h>
+#ifdef CONFIG_KSU_SUSFS
+#include <linux/cred.h>
+#include <linux/thread_info.h>
+#endif
 #include <linux/audit.h>
 #include <linux/mutex.h>
 #include <linux/selinux.h>
@@ -102,6 +106,15 @@ static struct sidtab sidtab;
 struct policydb policydb;
 int ss_initialized;
 
+#ifdef CONFIG_KSU_SUSFS
+/* caymanslm: type count captured the instant the base policy finishes
+ * loading, before any runtime injection. A SID whose type value exceeds it
+ * was injected into the live policydb afterwards (KernelSU's ksu/ksu_file,
+ * or module sepolicy.rule types such as xposed_data). See
+ * selinux_sid_is_hidden_from_caller() below. */
+u32 selinux_stock_type_ceiling __read_mostly;
+#endif
+
 /*
  * The largest sequence number that has been used when
  * providing an access decision to the access vector cache.
@@ -2141,6 +2154,9 @@ int security_load_policy(void *data, size_t len)
 
 		security_load_policycaps();
 		ss_initialized = 1;
+#ifdef CONFIG_KSU_SUSFS
+		selinux_stock_type_ceiling = policydb.p_types.nprim;
+#endif
 		seqno = ++latest_granting;
 		selinux_complete_init();
 		avc_ss_reset(seqno);
@@ -2218,6 +2234,11 @@ int security_load_policy(void *data, size_t len)
 	current_mapping_size = map_size;
 	seqno = ++latest_granting;
 	write_unlock_irq(&policy_rwlock);
+#ifdef CONFIG_KSU_SUSFS
+	/* re-arm after a genuine reload installs a fresh stock policydb;
+	 * KernelSU re-injects its types afterwards, above this new ceiling */
+	selinux_stock_type_ceiling = policydb.p_types.nprim;
+#endif
 
 	/* Free the old policydb and SID table. */
 	policydb_destroy(oldpolicydb);
@@ -2243,6 +2264,38 @@ int security_load_policy(void *data, size_t len)
 	return rc;
 }
 
+#ifdef CONFIG_KSU_SUSFS
+/* True when @sid names a type injected into the live policydb after the
+ * base policy loaded AND the caller is a sandboxed app. The userspace-facing
+ * selinuxfs/procattr query paths use this to make such a SID look
+ * non-existent to app probes (return -EINVAL).
+ *
+ * Gate on the same heuristic as KernelSU's selinux_hide feature -- an app is
+ * uid >= 10000 with seccomp installed. This must NOT fire for the root stack's
+ * own uid-0 machinery: ksud, su, zygote, system_server and the ReZygisk
+ * monitor/daemon legitimately resolve injected types (ksu, zygisk_file, ...)
+ * to set up module injection, and hiding them there breaks Zygisk. A detecto
+ * probing from an app is uid >= 10000 + seccomp, so it is still covered. */
+bool selinux_sid_is_hidden_from_caller(u32 sid)
+{
+	struct context *ctx;
+	bool hidden = false;
+
+	if (!ss_initialized || !selinux_stock_type_ceiling)
+		return false;
+	if (!(test_thread_flag(TIF_SECCOMP) && current_uid().val >= 10000))
+		return false;
+
+	read_lock(&policy_rwlock);
+	ctx = sidtab_search(&sidtab, sid);
+	if (ctx && ctx->type > selinux_stock_type_ceiling)
+		hidden = true;
+	read_unlock(&policy_rwlock);
+
+	return hidden;
+}
+#endif
+
 size_t security_policydb_len(void)
 {
 	size_t len;
