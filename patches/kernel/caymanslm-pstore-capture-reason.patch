diff --git a/drivers/soc/qcom/lge/Kconfig b/drivers/soc/qcom/lge/Kconfig
index e2962a372daf..31d9290cdbc9 100644
--- a/drivers/soc/qcom/lge/Kconfig
+++ b/drivers/soc/qcom/lge/Kconfig
@@ -340,6 +340,20 @@ config LGE_HANDLE_PANIC_RPMH_TIMEOUT
 	help
 	  LGE Crash Handler
 
+config CAYMANSLM_PSTORE_CAPTURE
+	bool "caymanslm: keep ramoops alive across a panic for capture (diagnostic)"
+	default n
+	depends on LGE_HANDLE_PANIC
+	help
+	  Diagnostic-only.  When set, lge_set_panic_reason() writes NO LGE
+	  kernel-crash magic into IMEM on a panic.  The SBL reads that magic to
+	  trigger a "hidden reset" -- a second, cold reboot that re-initialises
+	  DDR and wipes the ramoops/pstore ring before Linux can read it.  With
+	  no magic the SBL treats the (already warm) panic reset as an ordinary
+	  boot, so the ramoops region survives into the next boot and the panic
+	  backtrace can be read from /sys/fs/pstore.  Never enable in a shipped
+	  kernel.
+
 config LGE_PM_SMPL_COUNTER
 	tristate "Support LGE SMPL COUNTER feature"
 	default n
diff --git a/drivers/soc/qcom/lge/lge_handle_panic.c b/drivers/soc/qcom/lge/lge_handle_panic.c
index 75d9cc4bb3c8..1f64e3539e23 100644
--- a/drivers/soc/qcom/lge/lge_handle_panic.c
+++ b/drivers/soc/qcom/lge/lge_handle_panic.c
@@ -134,11 +134,35 @@ void lge_set_fb_addr(unsigned int addr)
 
 void lge_set_restart_reason(unsigned int reason)
 {
+#ifdef CONFIG_CAYMANSLM_PSTORE_CAPTURE
+	/*
+	 * pstore capture build: never stamp ANY LGE crash magic into IMEM, from
+	 * any path -- panic (lge_set_panic_reason), watchdog bark/bite
+	 * (watchdog_v2.c), or TZ.  The SBL reads that magic to trigger its
+	 * "hidden reset" (a cold reboot that re-inits DDR and wipes the ramoops
+	 * ring).  Forcing 0 makes every reset look ordinary, so ramoops survives
+	 * into the next boot for capture.  Diagnostic builds only.
+	 */
+	reason = 0;
+#endif
 	writel_relaxed(reason, RESTART_REASON);
 }
 
 void lge_set_panic_reason(void)
 {
+#ifdef CONFIG_CAYMANSLM_PSTORE_CAPTURE
+	/*
+	 * pstore capture build: do NOT stamp the LGE kernel-crash magic into
+	 * IMEM.  The SBL reads that magic and performs a "hidden reset" -- a
+	 * second, cold reboot that re-initialises DDR and wipes the ramoops
+	 * ring before Linux can read it.  Writing a non-magic value makes the
+	 * SBL treat the (already warm) panic reset as an ordinary boot, so the
+	 * ramoops region survives into the next boot and /sys/fs/pstore holds
+	 * the backtrace.  Diagnostic builds only -- never shipped.
+	 */
+	lge_set_restart_reason(0);
+	return;
+#endif
 	if (lge_get_download_mode() && gen_key_panic) {
 		lge_set_restart_reason(LGE_RB_MAGIC | LGE_ERR_KERN | LGE_ERR_KERN_KEY);
 		return;
