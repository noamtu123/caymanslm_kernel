Subject: [PATCH] ksu: cover newfstatat init.rc stat path

Android init on this 4.9 arm64 target uses newfstatat for init.rc. The
existing newfstat return hook cannot see that path because newfstatat receives
a pathname rather than an already-open file descriptor.

---
diff --git a/fs/stat.c b/fs/stat.c
--- a/fs/stat.c
+++ b/fs/stat.c
@@ -288,4 +288,6 @@
 extern int ksu_handle_stat(int *dfd, const char __user **filename_user,
 			int *flags);
+extern void ksu_handle_newfstatat_ret(const char __user **filename_user,
+			struct stat __user **statbuf_ptr);
 #endif
 
@@ -334,4 +336,9 @@ SYSCALL_DEFINE4(newfstatat, int, dfd, const char __user *, filename,
 	if (error)
 		return error;
-	return cp_new_stat(&stat, statbuf);
+	error = cp_new_stat(&stat, statbuf);
+#ifdef CONFIG_KSU
+	if (!error)
+		ksu_handle_newfstatat_ret(&filename, &statbuf);
+#endif
+	return error;
 }
 #endif
